FROM docker.io/library/python:3.12-slim

# Match EP's immutable SDK source revision, including its runtime APIs.
RUN pip install --no-cache-dir \
    'syntara-plugin-contracts @ https://github.com/syntara-orchestration/syntara-plugin-sdk/archive/c68afb3c1faaf36dcc45612b1bed28a508dc629f.tar.gz#subdirectory=sdks/python/packages/contracts'

COPY worker.py /opt/sdk-test-worker.py
USER 1001
EXPOSE 50051
CMD ["python", "/opt/sdk-test-worker.py"]
