FROM docker.io/library/python:3.12-slim

# The contracts package owns the runtime service. Match EP's immutable source
# revision: the published release still requires the removed workflow_run_id.
RUN pip install --no-cache-dir "syntara-plugin-contracts @ https://github.com/syntara-orchestration/syntara-plugin-sdk/archive/4e74cdd7775dd91329366b93a42c730553ce3a52.tar.gz#subdirectory=sdks/python/packages/contracts"

COPY worker.py /opt/sdk-test-worker.py
USER 1001
EXPOSE 50051
CMD ["python", "/opt/sdk-test-worker.py"]
